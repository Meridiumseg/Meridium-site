# Crie um projeto gratuito em https://supabase.com e copie estas chaves em
# Project Settings > API. Renomeie este arquivo para ".env.local".

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Usado apenas em Server Actions/rotas de servidor (nunca exposto ao navegador).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta
